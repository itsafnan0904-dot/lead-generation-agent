# Environment variables. Copy to apps/api/.env and fill in. NEVER commit the real .env (it is gitignored).
#
# Generate every secret below with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Generate GMAIL_TOKEN_ENCRYPTION_KEY with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production (NODE_ENV=production) the API refuses to start with short, placeholder or reused secrets.

# Node Environment
NODE_ENV=development

# API Configuration
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000

# Local Infrastructure Credentials (Postgres)
POSTGRES_USER=postgres
# Required by docker compose: pick a strong unique value (no default)
POSTGRES_PASSWORD=
POSTGRES_DB=ai_sales_agent
POSTGRES_PORT=5432

# Local Infrastructure Credentials (Redis)
REDIS_PORT=6379

# Database Connection String (PostgreSQL via Prisma)
# Use the same password as POSTGRES_PASSWORD
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ai_sales_agent?schema=public

# Redis Connection URL (for BullMQ queues)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets
# Three DIFFERENT secrets of 32+ characters each
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Signs the short-lived token used when linking a Google account (required at startup)
JWT_LINK_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (User Login Client - distinct from Gmail sending client)
GOOGLE_LOGIN_CLIENT_ID=your_google_login_client_id_here.apps.googleusercontent.com
GOOGLE_LOGIN_CLIENT_SECRET=your_google_login_client_secret_here
GOOGLE_LOGIN_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Gmail OAuth & Encryption (System Shared Account - distinct from User Login client)
GMAIL_OAUTH_CLIENT_ID=your_gmail_oauth_client_id_here.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=your_gmail_oauth_client_secret_here
GMAIL_OAUTH_CALLBACK_URL=http://localhost:4000/gmail/oauth/callback
# 32-byte hex key (64 hex characters). Losing it makes stored Gmail tokens unreadable, so back it up.
GMAIL_TOKEN_ENCRYPTION_KEY=

# AI auto-reply to inbound client messages
# off   = kill switch, the AI never drafts or sends replies
# draft = (default) the AI drafts a reply and a human approves/sends it
# auto  = the AI sends replies by itself, ONLY for leads an admin opted in to autonomous mode,
#         and still subject to OUTREACH_DAILY_LIMIT, sending hours and OUTREACH_SAFE_TEST_MODE
AUTO_REPLY_MODE=draft
AUTO_REPLY_MAX_PER_LEAD_PER_DAY=3

# Scheduled follow-ups to leads that went quiet after our last message.
# The scheduled scan is OFF unless FOLLOW_UP_AUTOMATION_ENABLED=true.
# FOLLOW_UP_MODE (off|draft|auto, default draft) is capped by AUTO_REPLY_MODE: if that is off, follow-ups are off.
FOLLOW_UP_AUTOMATION_ENABLED=false
FOLLOW_UP_SCAN_INTERVAL_MINUTES=60
FOLLOW_UP_MODE=draft
FOLLOW_UP_AFTER_DAYS=3
FOLLOW_UP_MAX_COUNT=2

# OpenAI (research, scoring, reply and follow-up drafting)
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini

# Outreach safety. OUTREACH_SAFE_TEST_MODE=true redirects EVERY outgoing email to OUTREACH_TEST_RECIPIENT_EMAIL.
# Set it to false only when you are ready to email real prospects.
OUTREACH_SAFE_TEST_MODE=true
OUTREACH_TEST_RECIPIENT_EMAIL=you@example.com
OUTREACH_DAILY_LIMIT=15
OUTREACH_SENDING_HOURS_START=9
OUTREACH_SENDING_HOURS_END=17
SENDER_COMPANY_NAME=Your Company

# Gmail inbox sync (BullMQ, needs Redis)
GMAIL_SYNC_AUTOMATION_ENABLED=true
GMAIL_SYNC_INTERVAL_MINUTES=5

# ---- Access control and network hardening ----
# Self-service sign-up is OFF by default. Create the first admin with:
#   ADMIN_EMAIL=you@company.com ADMIN_PASSWORD='a long unique passphrase' npm run create-admin --workspace=apps/api
# then add teammates through POST /users (administrators only). Only set this to true on a private test setup.
ALLOW_PUBLIC_REGISTRATION=false
# Google sign-in may create accounts only for these email domains (comma separated). Empty = nobody new.
GOOGLE_ALLOWED_DOMAINS=
# Browsers are denied cross-origin access to the API unless their origin is listed here (comma separated).
# The web app calls the API server-side, so this normally stays empty.
CORS_ORIGINS=
# Which proxy hops may supply the client IP (X-Forwarded-For) for rate limiting: loopback (default), false, a hop
# count such as 1, or a comma list of addresses/subnets. Set to match your reverse proxy in production.
TRUST_PROXY=loopback
# Requests per minute per IP across the API (login and sign-up have much stricter built-in limits)
RATE_LIMIT_PER_MINUTE=300
