# Environment Variables Placeholder Example

# Node Environment
NODE_ENV=development

# API Configuration
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000

# Local Infrastructure Credentials (Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_sales_agent
POSTGRES_PORT=5432

# Local Infrastructure Credentials (Redis)
REDIS_PORT=6379

# Database Connection String (PostgreSQL via Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_sales_agent?schema=public

# Redis Connection URL (for BullMQ queues)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
# Signs the short-lived token used when linking a Google account (required at startup)
JWT_LINK_SECRET=your_jwt_link_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (User Login Client - distinct from Gmail sending client)
GOOGLE_LOGIN_CLIENT_ID=your_google_login_client_id_here.apps.googleusercontent.com
GOOGLE_LOGIN_CLIENT_SECRET=your_google_login_client_secret_here
GOOGLE_LOGIN_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Gmail OAuth & Encryption (System Shared Account - distinct from User Login client)
GMAIL_OAUTH_CLIENT_ID=your_gmail_oauth_client_id_here.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=your_gmail_oauth_client_secret_here
GMAIL_OAUTH_CALLBACK_URL=http://localhost:4000/gmail/oauth/callback
# 32-byte hex key (64 hex characters) e.g. openssl rand -hex 32
GMAIL_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI auto-reply to inbound client messages
# off   = kill switch, the AI never drafts or sends replies
# draft = (default) the AI drafts a reply and a human approves/sends it
# auto  = the AI sends replies by itself, ONLY for leads an admin opted in to autonomous mode,
#         and still subject to OUTREACH_DAILY_LIMIT, sending hours and OUTREACH_SAFE_TEST_MODE
AUTO_REPLY_MODE=draft
AUTO_REPLY_MAX_PER_LEAD_PER_DAY=3

# Scheduled follow-ups to leads that went quiet after our last message.
# The scheduled scan is OFF unless FOLLOW_UP_AUTOMATION_ENABLED=true.
# FOLLOW_UP_MODE (off|draft|auto, default draft) is capped by AUTO_REPLY_MODE: if that is off, follow-ups are off.
FOLLOW_UP_AUTOMATION_ENABLED=false
FOLLOW_UP_SCAN_INTERVAL_MINUTES=60
FOLLOW_UP_MODE=draft
FOLLOW_UP_AFTER_DAYS=3
FOLLOW_UP_MAX_COUNT=2

# OpenAI (research, scoring, reply and follow-up drafting)
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini

# Outreach safety. OUTREACH_SAFE_TEST_MODE=true redirects EVERY outgoing email to OUTREACH_TEST_RECIPIENT_EMAIL.
# Set it to false only when you are ready to email real prospects.
OUTREACH_SAFE_TEST_MODE=true
OUTREACH_TEST_RECIPIENT_EMAIL=you@example.com
OUTREACH_DAILY_LIMIT=15
OUTREACH_SENDING_HOURS_START=9
OUTREACH_SENDING_HOURS_END=17
SENDER_COMPANY_NAME=Your Company

# Gmail inbox sync (BullMQ, needs Redis)
GMAIL_SYNC_AUTOMATION_ENABLED=true
GMAIL_SYNC_INTERVAL_MINUTES=5
