# Environment Variables Placeholder Example

# Node Environment
NODE_ENV=development

# API Configuration
PORT=4000
API_URL=http://localhost:4000

# Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000

# Local Infrastructure Credentials (Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_sales_agent
POSTGRES_PORT=5432

# Local Infrastructure Credentials (Redis)
REDIS_PORT=6379

# Database Connection String (PostgreSQL via Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_sales_agent?schema=public

# Redis Connection URL (for BullMQ queues)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (User Login Client - distinct from Gmail sending client)
GOOGLE_LOGIN_CLIENT_ID=your_google_login_client_id_here.apps.googleusercontent.com
GOOGLE_LOGIN_CLIENT_SECRET=your_google_login_client_secret_here
GOOGLE_LOGIN_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Gmail OAuth & Encryption (System Shared Account - distinct from User Login client)
GMAIL_OAUTH_CLIENT_ID=your_gmail_oauth_client_id_here.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=your_gmail_oauth_client_secret_here
GMAIL_OAUTH_CALLBACK_URL=http://localhost:4000/gmail/oauth/callback
# 32-byte hex key (64 hex characters) e.g. openssl rand -hex 32
GMAIL_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
