generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Retained for lightweight infrastructure/connection health checks
model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  ADMIN
  SALES_REP
  MANAGER
  VIEWER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum LeadLifecycleStatus {
  COLD_LEAD
  CONTACTED
  RESPONDED
  INTERESTED
  GATHERING_REQUIREMENTS
  QUALIFIED
  DEAL_DISCUSSION
  WON
  LOST
  WAITING_FOR_CLIENT
  FOLLOW_UP_REQUIRED
  HUMAN_REVIEW
  RESTRICTED
  DISQUALIFIED
}

enum RestrictionCheckResult {
  CLEAR
  HUMAN_REVIEW
  RESTRICTED
}

enum RestrictionEntityType {
  COMPANY
  CONTACT
  LEAD
}

enum HumanReviewStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  ESCALATED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum AIActionStatus {
  PENDING
  EXECUTED
  FAILED
  REJECTED
}

enum NotificationPriority {
  INFO
  IMPORTANT
  ACTION_REQUIRED
}

enum OutreachDraftStatus {
  DRAFT
  SENT
  FAILED
  CANCELLED
}

enum AIControlState {
  AI_ACTIVE
  PAUSED
  TAKEN_OVER
}

enum HumanReviewTriggerSource {
  RESTRICTION_CHECK
  AI_REPLY_FLAG
  MANUAL
}

// -----------------------------------------------------------------------------
// Core Domain Models
// -----------------------------------------------------------------------------

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  name             String
  googleId         String?       @unique
  passwordHash     String?
  refreshTokenHash String?
  role             UserRole      @default(SALES_REP)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  assignedLeads   Lead[]          @relation("AssignedUserLeads")
  humanReviews    HumanReview[]   @relation("ReviewerUser")
  resolvedReviews HumanReview[]   @relation("ResolvedByUser")
  notifications   Notification[]
  auditEvents     AuditEvent[]
  gmailAccounts   GmailAccount[]  @relation("ConnectedGmailUser")

  @@index([role])
}

model GmailAccount {
  id                String    @id @default(uuid())
  email             String    @unique
  accessToken       String    @db.Text
  refreshToken      String    @db.Text
  tokenExpiresAt    DateTime
  scope             String    @db.Text
  isActive          Boolean   @default(true)
  connectedByUserId String?
  connectedByUser   User?     @relation("ConnectedGmailUser", fields: [connectedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([isActive])
  @@index([connectedByUserId])
}

model Campaign {
  id          String         @id @default(uuid())
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)
  targetCriteria Json?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  leads       Lead[]

  @@index([status])
}

model Company {
  id             String             @id @default(uuid())
  name           String
  domain         String?            @unique
  industry       String?
  size           String?
  location       String?
  country        String?
  website        String?
  linkedinUrl    String?
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  contacts       Contact[]
  leads          Lead[]
  research       Research[]
  restrictionChecks RestrictionCheck[]

  @@index([name])
}

model Contact {
  id             String             @id @default(uuid())
  companyId      String
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  email          String             @unique
  firstName      String
  lastName       String?
  title          String?
  phone          String?
  linkedinUrl    String?
  timezone       String?
  isPrimary      Boolean            @default(false)
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  leads          Lead[]
  restrictionChecks RestrictionCheck[]

  @@index([companyId])
  @@index([firstName, lastName])
}

model Lead {
  id                  String              @id @default(uuid())
  companyId           String
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  primaryContactId    String?
  primaryContact      Contact?            @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  campaignId          String?
  campaign            Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  assignedUserId      String?
  assignedUser        User?               @relation("AssignedUserLeads", fields: [assignedUserId], references: [id], onDelete: SetNull)

  status              LeadLifecycleStatus @default(COLD_LEAD)
  aiControlState      AIControlState      @default(AI_ACTIVE)

  // Scoring breakdown (Sum total 100 max)
  scoreTotal          Int                 @default(0)
  scoreServiceMatch   Int                 @default(0) // Max 40
  scoreCompanyRelevance Int               @default(0) // Max 20
  scoreContactQuality Int                 @default(0) // Max 15
  scoreProjectPotential Int               @default(0) // Max 15
  scoreLocationMatch  Int                 @default(0) // Max 10
  scoreBreakdownReason Json?

  metadata            Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  research            Research[]
  conversations       Conversation[]
  projects            Project[]
  qualifications      Qualification[]
  humanReviews        HumanReview[]
  aiActions           AIAction[]
  restrictionChecks   RestrictionCheck[]
  outreachDrafts      OutreachDraft[]

  @@index([companyId])
  @@index([primaryContactId])
  @@index([campaignId])
  @@index([assignedUserId])
  @@index([status])
  @@index([aiControlState])
  @@index([scoreTotal])
}

model Research {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  leadId         String?
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  companySummary String?   @db.Text
  newsAndEvents  Json?
  painPoints     Json?
  techStack      Json?
  keyInsights    Json?
  rawResearchData Json?
  sources        Json?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId])
  @@index([leadId])
}

model Conversation {
  id              String       @id @default(uuid())
  leadId          String?
  lead            Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  gmailThreadId   String?      @unique
  subject         String?
  channel         String       @default("EMAIL")
  isArchived      Boolean      @default(false)
  lastMessageAt   DateTime?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  messages        Message[]
  humanReviews    HumanReview[]
  aiActions       AIAction[]

  @@index([leadId])
}

model Message {
  id             String           @id @default(uuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  gmailMessageId String?          @unique
  direction      MessageDirection
  sender         String
  recipient      String
  subject        String?
  bodyText       String           @db.Text
  bodyHtml       String?          @db.Text
  sentAt         DateTime         @default(now())
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  aiActions      AIAction[]
  humanReviews   HumanReview[]

  @@index([conversationId])
  @@index([sentAt])
}

model Project {
  id             String    @id @default(uuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Restrict)
  title          String
  description    String?   @db.Text
  scope          Json?
  budget         Decimal?  @db.Decimal(12, 2)
  currency       String    @default("USD")
  timeline       String?
  documentKey    String?   // S3/GCS object key / cloud storage pointer
  documentBucket String?   // S3 bucket or external container name
  documentName   String?   // Original filename
  documentMime   String?   // MIME type (e.g. application/pdf)
  documentSize   Int?      // Size in bytes
  metadata       Json?     // Extracted metadata / additional doc tags
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([leadId])
}

model Qualification {
  id             String   @id @default(uuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  budgetFit      Boolean?
  authorityFit   Boolean?
  needFit        Boolean?
  timelineFit    Boolean?
  technicalFit   Boolean?
  fitSummary     String?  @db.Text
  dealBlockers   Json?
  answers        Json?
  qualifiedBy    String?  // AI or User ID
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([leadId])
}

model RestrictionCheck {
  id             String                 @id @default(uuid())
  entityType     RestrictionEntityType
  companyId      String?
  company        Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?               @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?                  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  result         RestrictionCheckResult
  matchedRules   Json?
  reason         String?                @db.Text
  checkedPayload Json?
  createdAt      DateTime               @default(now())

  humanReviews   HumanReview[]

  @@index([entityType])
  @@index([companyId])
  @@index([contactId])
  @@index([leadId])
  @@index([result])
  @@index([createdAt])
}

model HumanReview {
  id                      String                    @id @default(uuid())
  leadId                  String?
  lead                    Lead?                     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversationId          String?
  conversation            Conversation?             @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId               String?
  message                 Message?                  @relation(fields: [messageId], references: [id], onDelete: SetNull)
  restrictionCheckId      String?
  restrictionCheck        RestrictionCheck?         @relation(fields: [restrictionCheckId], references: [id], onDelete: SetNull)
  assignedToId            String?
  assignedTo              User?                     @relation("ReviewerUser", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedByUserId        String?
  resolvedByUser          User?                     @relation("ResolvedByUser", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  status                  HumanReviewStatus         @default(PENDING)
  triggerSource           HumanReviewTriggerSource  @default(RESTRICTION_CHECK)
  triggerReason           String                    @db.Text
  resolutionJustification String?                   @db.Text
  aiDraftContent          String?                   @db.Text
  reviewedContent         String?                   @db.Text
  reviewNotes             String?                   @db.Text
  resolvedAt              DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([leadId])
  @@index([conversationId])
  @@index([messageId])
  @@index([restrictionCheckId])
  @@index([assignedToId])
  @@index([resolvedByUserId])
  @@index([status])
  @@index([triggerSource])
}

model AIAction {
  id             String         @id @default(uuid())
  leadId         String?
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId      String?
  message        Message?       @relation(fields: [messageId], references: [id], onDelete: SetNull)
  actionType     String         // e.g. DRAFT_EMAIL, SCORE_LEAD, EXTRACT_REQUIREMENTS, RESTRICTION_CHECK
  promptSnapshot String?        @db.Text
  rawOutput      String?        @db.Text
  parsedPayload  Json?
  modelUsed      String?
  tokenUsage     Json?
  latencyMs      Int?
  status         AIActionStatus @default(PENDING)
  errorMessage   String?        @db.Text
  createdAt      DateTime       @default(now())

  @@index([leadId])
  @@index([conversationId])
  @@index([messageId])
  @@index([actionType])
  @@index([createdAt])
}

model Notification {
  id           String               @id @default(uuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  priority     NotificationPriority @default(INFO)
  title        String
  message      String               @db.Text
  entityType   String?              // e.g. "LEAD", "CONVERSATION", "HUMAN_REVIEW"
  entityId     String?              // UUID of referenced target entity
  isRead       Boolean              @default(false)
  readAt       DateTime?
  metadata     Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([priority])
  @@index([createdAt])
}

model AuditEvent {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorType    String   @default("USER") // USER, AI, SYSTEM
  actorId      String?
  action       String   // e.g. LEAD_CREATED, EMAIL_SENT, HUMAN_OVERRIDE, HUMAN_REVIEW_RESOLVED
  entityType   String   // e.g. LEAD, CONVERSATION, RESTRICTION_CHECK, HUMAN_REVIEW
  entityId     String?
  oldState     Json?
  newState     Json?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([actorType])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model OutreachDraft {
  id               String              @id @default(uuid())
  leadId           String
  lead             Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  subject          String
  bodyText         String              @db.Text
  bodyHtml         String?             @db.Text
  callToAction     String?
  rationale        String?             @db.Text
  personalizationPoints Json?
  status           OutreachDraftStatus @default(DRAFT)
  aiUsageMetadata  Json?
  gmailMessageId   String?             @unique
  gmailThreadId    String?
  sentAt           DateTime?
  errorMessage     String?             @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([leadId])
  @@index([status])
  @@index([createdAt])
}

